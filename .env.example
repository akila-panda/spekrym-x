# Copy to .env and fill in. Never commit .env.

# OANDA practice (demo) account only
OANDA_ENV=practice
OANDA_TOKEN=
OANDA_ACCOUNT_ID=

# Interactive Brokers paper (optional)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# LLM provider for the analyst (optional)
ANTHROPIC_API_KEY=

# Hard safety switch. Must stay "paper".
SX_TRADING_MODE=paper
